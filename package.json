{
  "name": "footnote-rag",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:reset-embeddings": "tsx --env-file=.env scripts/reset-embeddings.ts",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "ask": "tsx --env-file=.env scripts/ask.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts"
  },
  "dependencies": {
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
